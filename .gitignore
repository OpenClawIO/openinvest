# See https://help.github.com/articles/ignoring-files/

# secrets — never commit
.env
.env.*
!.env.example

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next
.next
out
build
dist
coverage
*.tsbuildinfo
next-env.d.ts

# debug / os
npm-debug.log*
.DS_Store
*.pem
.vscode
.idea

# Flex raw dumps may include account numbers
data/raw/

# local browser traces
.playwright-cli/

# optional Blender meshes — the live stage is procedural Three.js
/public/models/
